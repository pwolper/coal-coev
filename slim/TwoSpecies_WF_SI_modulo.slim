species host survival() {
	// non-overlapping host generations
	return (individual.age == 0);
}

species pathogen survival() {
	return (g != 0) | (individual.age == 0); // pathogens die only at tick g=0 or if their age is older than 1. 
}

ticks all 1: late() {
	catn("-- late() --");
	// catn("HostPedigreeIDs:");
	// catn(p1.individuals.pedigreeID);
	// catn("Hosts.tag: "); catn(p1.individuals.tag);
	// catn("Host.pedigreeIDs: "); catn(p1.individuals.pedigreeID);
	
	pathogens = p2.individuals;
	J = size(pathogens);
	
	
	
	if (J < 10)  {cat("pathogens.tag: "); catn(pathogens.tag);} // conditional printing
	else {catn("Infected J = " + size(pathogens));}
	
	if (J == 0) {
		catn("Pathogen extinct at tick " + community.tick + "!!");
		community.simulationFinished();
	}
	else if (J >= N_Host) {
		catn("Pathogen fixed (all hosts infected) at tick " + community.tick + "!!");
		community.simulationFinished();
	}
}

