// Keywords: multispecies, interaction

species all initialize() {
	initializeSLiMModelType("nonWF");
	
	defineConstant("N_Host", 100); //constant host population size
	defineConstant("beta", 0.1); //contact rate, with which infected host will infect another host
	defineConstant("c_v", 0.5); //probability of vertical transmission
	defineConstant("G", 15); //relative epidemic time
}

species host initialize() {
	initializeSpecies(tickModulo=G+1, avatar="🌾", color='green');
	initializeSLiMOptions(keepPedigrees=T);
}

species pathogen initialize() {
	initializeSpecies(tickModulo=1, avatar="🦠", color='red');
	//initializeSLiMOptions(keepPedigrees=T); are pdeigreeID of two species unique?
}



species host reproduction() {
	catn("-- Host reproduction callback -- ");
	hostLineageDict = Dictionary();
	// Host WF reproduction step
	parents = p1.sampleIndividuals(N_Host, replace=T);
	for (parent in parents) {
		offspring = subpop.addCloned(parent);
		offspring.color = parent.color;
		offspring.tagL0 = parent.tagL0;
		
		parentID = asString(parent.pedigreeID);
		hostLineageDict.setValue(parentID, c(hostLineageDict.getValue(parentID), offspring.pedigreeID)); // host.pedigreeIDs; {parent: offspring}
	}
	defineGlobal("hostLineageDict", hostLineageDict);
	//catn(hostLineageDict);
	self.active = 0;
}

species pathogen reproduction() {
	catn("-- Pathogen reproduction callback --");
	
	//vertical transmission after host reproduction
	if (g == 0) {
		catn("\t\t - Vertical transmission (g = 0)");
		//catn(hostLineageDict);
		pathogens = p2.individuals;
		
		for (pathInd in p2.individuals) {
			HostOffspring = hostLineageDict.getValue(asString(pathInd.tag));   // get vector of host offspring.pedigreeIDs from hostLineageDict {parent: offspring} from pathInd.tag, matching the host.parent.pedID.  
			//cat("\t\t\tHost: " + pathInd.tag + " -->"); catn(" " + HostOffspring);
			
			if (size(HostOffspring) > 0) {
				//catn(rbinom(size(HostOffspring), 1, asFloat(c_v)));
				transmitted = HostOffspring[rbinom(size(HostOffspring), 1, asFloat(c_v)) == 1];
				for (offspring in transmitted) {
					verticalPathogen = subpop.addCloned(pathInd);
					verticalPathogen.tag = offspring;
					verticalPathogen.color = pathInd.color;
				}
			}
		}
	}
	
	else {
		// Horizontal transmission
		catn("\t\t - Horizontal transmission - ");
		
		pathogens = p2.individuals;
		J = size(pathogens);
		cat("\t\t\tJ = " + J); //cat("pathogen.tag: "); catn(pathogens.tag);
		uninfectedHosts = p1.individuals[match(p1.individuals.pedigreeID, pathogens.tag) < 0]; //hosts whose pedigreeID is not in any pathogen tag. Use tag to mark hosts as infected later
		S = size(uninfectedHosts);
		cat(";\t S = " + S); //cat("Un-infected Hosts: "); catn(uninfectedHosts); 
		
		// Frozen j, big-bang Contacts
		Ce = rpois(1, (beta * J * S) / N_Host);
		catn(";\t Ce = Poisson((beta*J*S)/N) = " + Ce);
		if (Ce > 0) {
			infectors = sample(pathogens, Ce, replace=T); 	// pathogen from infecting host
			//cat("\t\t\tInfecting Pathogen from Host: "); catn(infectors.tag);
			targets = sample(uninfectedHosts, Ce, replace=T); // tag of the receiving host. list of inds instead
			//cat("\t\t\tTarget Host: "); catn(targets.pedigreeID);
			
			// A S host hit twice in one tick. Should only get infected once by the first infection (or overwritten?)
			keep      = (match(targets, targets) == seqAlong(targets));
			infectors = infectors[keep];
			cat("\t\t\t infectors[keep] = "); catn(size(infectors.tag));
			targets   = targets[keep];
			cat("\t\t\ttargets[keep] = "); catn(size(targets.pedigreeID));
			
			for (i in seqAlong(infectors)) {
				newPath = p2.addCloned(infectors[i]);
				newPath.tag = targets[i].pedigreeID;
				newPath.color = targets[i].color;// add more coloring matching clades
			}
		}
		// Alternatively non-big-bang callback and non-frozen within tick 
		// Simulate all contacts per tick at once and randomly sample infected and susceptible pairs to transmit individual pathogens.
		// OR alternatively change call back to per individual call back, so we can unfreeze the number of J and S within the tick .
		// Nicer but probably slower? 
	
	}
	
	self.active = 0;
}


ticks all 1 early() {
	catn(" -- early() --");
	// Host creation
	host.addSubpop("p1", N_Host, haploid=T);
	p1.individuals.tagL0 = F; //Infection status. F for healthy, T for infected
	p1.individuals.color = colors(p1.individualCount, "turbo");
	p1.individuals.tag = seqLen(p1.individualCount);
	//catn("Hosts: "); catn(p1.individuals.tag);
	
	//initial infection
	pathogen.addSubpop("p2", 1);
	newHost = p1.sampleIndividuals(1);
	newHost.tagL0 = T; //newHost.color = "red";
	catn("Initial infection in host " + newHost.pedigreeID);
	p2.individuals.color = newHost.color;
	p2.individuals.tag = newHost.pedigreeID; //tag pathogen with host.pedigreeID

}

